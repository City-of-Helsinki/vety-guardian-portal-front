VITE_API_BASE_URL=http://localhost:8001
VITE_LOCIZE_PROJECT_ID=

# Helsinki-profiili login (Helsinki Tunnistus). The client must allow
# http://localhost:5173/auth/helsinki/return as a redirect URI and
# http://localhost:5173/auth/helsinki/logout as a post-logout redirect URI.
VITE_OIDC_AUTHORITY=https://tunnistus.test.hel.ninja/auth/realms/helsinki-tunnistus
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile
VITE_OIDC_API_AUDIENCE=
VITE_OIDC_PROFILE_API_AUDIENCE=profile-api-test
